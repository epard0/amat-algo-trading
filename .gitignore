# Shared publication and local-state rules for all AMAT workspace components.

# ---------------------------------------------------------------------------
# Secrets and machine-local configuration
# ---------------------------------------------------------------------------
**/.env
**/.env.*
!**/.env.example
# Match either a file or a directory; both forms exist in developer workspaces.
**/secrets
**/credentials
**/.mcp.json
*.pem
*.key
*.p12
*.pfx
.superpowers/
# Local shell/user configuration accidentally copied into a project.
**/.bash_history
**/.zsh_history
**/.bash_profile
**/.bashrc
**/.profile
**/.gitconfig
**/.claude/
# ---------------------------------------------------------------------------
# Python environments, bytecode, packaging, and test/tool caches
# ---------------------------------------------------------------------------
**/.venv/
**/venv/
**/env/
**/__pycache__/
*.py[cod]
*.pyd
*.so
**/.Python
**/*.egg-info/
**/.eggs/
**/build/
**/dist/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
**/.tox/
**/.nox/
**/.coverage
**/.coverage.*
**/htmlcov/
# Jupyter-generated state; notebook sources remain trackable.
**/.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# JavaScript/package-manager generated content
# ---------------------------------------------------------------------------
**/node_modules/
**/.npm/
**/.pnpm-store/
**/.yarn/cache/
**/.yarn/install-state.gz

# ---------------------------------------------------------------------------
# AMAT research data and generated evidence
#
# These directories are intentionally local. Snapshot/run provenance is carried
# by manifests and digests, not by committing large vendor and report artifacts.
# ---------------------------------------------------------------------------
/amat/data/
/amat/outputs/

# ---------------------------------------------------------------------------
# Executor runtime state and guarded-rebuild artifacts
# ---------------------------------------------------------------------------
/executor/state/
/executor/reports/
/executor/plans/
/executor/backups/
/executor/*.ndjson

# Local Compose changes and exported container/account data.
/executor/docker-compose.override.yml
/executor/compose.override.yml
/executor/account-before.json
/executor/account-after.json

# ---------------------------------------------------------------------------
# Claude/local agent state while preserving shared rules, skills, and templates
# ---------------------------------------------------------------------------
**/.claude/settings.local.json
**/.claude/agent-memory-local/
**/.claude/worktrees/
**/.claude/.cache/
**/.claude/logs/
**/.claude/tsc-cache/
**/.claude/.cc-writes/
**/.claude/*.tmp

# ---------------------------------------------------------------------------
# Editors, operating systems, logs, and temporary files
# ---------------------------------------------------------------------------
# Match file markers as well as the usual directories.
**/.idea
**/.vscode
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/*~
**/*.log
**/*.tmp
**/*.temp

# Root-level scratch and coverage/report directories.
/.cache/
/tmp/
/temp/
/coverage/

# Publication excludes: private workstation material and generated evidence.
/.KEYS/
/.agents/
/.playwright-mcp/
/skills-lock.json
/amat-server-*.tar.*
/operations/
/kalshi-perps/outputs/
# Historical audit screenshots / generated analysis; keep their Markdown guides.
/frontend/docs/**/*.png
/frontend/docs/*.json
/docs/alpha-review-2026-09-30/*.json
/docs/alpha-review-2026-09-30/*.csv
/docs/alpha-implementation-plan-2026-10-08/source-manifest.json
/docs/alpha-implementation-plan-2026-10-08/validation.json
/amat/docs/phase0-evidence-2026-09-20/
/amat/docs/**/*.json
!/amat/docs/**/*.example.json
/amat/docs/**/*.csv
/amat/docs/**/*.png
# Private connection configuration; examples remain publishable.
/frontend/config/remote.toml
**/.ssh/
**/id_rsa
**/id_ed25519
**/*.sqlite
**/*.sqlite3
**/*.sqlite-wal
**/*.sqlite-shm
**/*.sqlite3-wal
**/*.sqlite3-shm
**/*.db
**/*.db-wal
**/*.db-shm
# Explicit safe templates, after generic environment exclusions.
!**/.env.example
!**/.env.*.example

# Private SSH connection identities/trust files, independent of their location.
**/remote.toml
**/ssh.toml
**/*.local.toml
**/known_hosts
**/known_hosts.*
**/authorized_keys
**/id_ecdsa
**/id_dsa
**/*.pub
# Immutable operator-specific historical notes stay local, like operations/.
/docs/frontend/OPERATIONS_VERIFICATION.md
/docs/frontend/VPS_PAPER_DEPLOYMENT_2026-10-20.md
/docs/research/remote-paper-monitor.md

# Relocated documentation may reference local generated research/audit artifacts.
/docs/research/phase0-evidence-2026-09-20/
/docs/research/**/*.json
!/docs/research/**/*.example.json
/docs/research/**/*.csv
/docs/research/**/*.png
/docs/frontend/**/*.png
/docs/frontend/*.json

# Keep legacy private-note locations excluded if an older operator tool recreates them.
/frontend/docs/OPERATIONS_VERIFICATION.md
/frontend/docs/VPS_PAPER_DEPLOYMENT_2026-10-20.md
/amat/docs/remote-paper-monitor.md
