# AMAT executor configuration.
#
# Copy to `.env`, fill in, and `chmod 600 .env`. Never commit the filled copy.
# Every value here is read from the process environment; none can be passed as
# a CLI flag, so credentials stay out of shell history and `ps` output.

# --- Alpaca PAPER trading credentials (place orders) ------------------------
# From https://app.alpaca.markets/paper/dashboard/overview -> "API Keys".
# These are distinct from the market-data keys below on purpose: a data key
# cannot place an order, and a trading key has no business in a backtest.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=

# --- Alpaca market-data credentials (read bars) -----------------------------
# Used by `amat plan` to extend the snapshot to the present before deciding.
ALPACA_MARKET_API_KEY=
ALPACA_MARKET_API_SECRET=

# --- Strategy ---------------------------------------------------------------
# The `amat` checkout. Inside the container this is the read-only mount point.
AMAT_ROOT=/opt/amat
STRATEGY_CONFIG=/opt/amat/configs/strategy/amat_v6.toml
# The immutable snapshot the plan extends from. Required; no default, because
# silently planning against the wrong history is worse than failing to start.
SNAPSHOT=/opt/amat/data/snapshots/alpaca-sip-2026-08-11

# Optional short-lived artifact generated before the plan phase with:
#   uv run newsdesk --db data/news/news.sqlite3 discover-assets \
#     --themes configs/news/themes.toml --out outputs/news/assets.json
# When set, positive candidates enter a separately capped 10% risk cluster.
# Leave empty to preserve the static configured universe exactly.
NEWS_ASSETS=

# --- Executor state ---------------------------------------------------------
STATE_ROOT=/var/lib/amat-executor

# Trading days of report and plan files kept on disk. The equity curve and the
# journal are append-only and are never pruned -- see README, "Reports and
# retention".
REPORT_RETENTION_DAYS=7

# Minutes before the open to build the plan, and after the close to report.
PLAN_LEAD_MINUTES=10
REPORT_DELAY_MINUTES=15

# The submit phase will not run within this many minutes of the close. It is
# the *end* of the window a rebalance may go in: if the host was asleep or the
# process was down at the open, the daemon still rebalances when it comes back
# and records the submission as late in that day's report. Set it wider than
# you expect any outage to last, but never so wide that the day's orders could
# land at the bell.
SUBMIT_CUTOFF_MINUTES=30

# Run every check and every sizing decision, but send no orders. Strongly
# recommended for the first few sessions of any new deployment.
DRY_RUN=true

# --- Daily report email -----------------------------------------------------
# Leave SMTP_HOST empty to disable mail entirely; the report is still written
# to disk and the trading loop is unaffected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
REPORT_SENDER=
# Comma-separated. Required whenever SMTP_HOST is set.
REPORT_RECIPIENTS=
