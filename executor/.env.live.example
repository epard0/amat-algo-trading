# Private live configuration. Copy to .env.live and chmod 600; never commit secrets.
# No live deployment is performed by implementation or tests.
TRADING_MODE=live
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ALPACA_LIVE_ACCOUNT_NUMBER=
ALPACA_MARKET_API_KEY=
ALPACA_MARKET_API_SECRET=
AMAT_ROOT=/opt/amat
STRATEGY_CONFIG=/opt/amat/configs/strategy/amat_group_selection_volatility.toml
SNAPSHOT=/opt/amat/data/snapshots/alpaca-sip-2026-08-11
STATE_ROOT=/var/lib/amat-executor-live
AUTHORIZED_CONFIG_SHA256=
# Set finite caps explicitly for the funded account; empty values fail closed.
MAX_SESSION_NOTIONAL=
MAX_SYMBOL_NOTIONAL=
MAX_ORDERS_PER_SESSION=
DRY_RUN=true
EXECUTOR_DISABLED=true
LIVE_TRADING_ENABLED=false
EXECUTION_MODE=staged-v1
