# Kalshi endpoints
KALSHI_PRODUCTION=https://external-api.kalshi.com/trade-api/v2
KALSHI_DEMO=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_WEBSOCKET_API_PROD=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_WEBSOCKET_API_DEMO=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2

# Credentials. Never commit real values.
KALSHI_API_KEY=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY_PATH=private_key.pem
KALSHI_PUBLIC_KEY_PATH=public_key.pem
KALSHI_SUBACCOUNT=0

# Live execution requires this setting AND the --live CLI flag.
KALSHI_ENVIRONMENT=demo
ENABLE_LIVE_TRADING=false

# Risk and model controls
# Every supported 15-minute crypto and commodity series. Unset to trade all;
# narrow it to a subset here or with --assets.
TRADING_ASSETS=BTC,ETH,SOL,HYPE,DOGE,XRP,BNB,NEAR,ZEC,GOLD,SILVER,WTI
# Offline-fitted one-minute yfinance directional priors for commodities and
# altcoins. Runtime uses Pyth for commodity and Kraken for crypto prices; only
# models clearing purged chronological validation receive a non-zero weight.
COMMODITY_MODEL_PATH=models/commodity_directional.json
# Fixed per-trade risk budget, shared by paper and live. Probability and Kelly
# never increase it. LIVE_CAPITAL_LIMIT_USD/POSITION_FRACTION remain accepted
# for older configuration files but do not size new orders.
TRADE_BUDGET_USD=50
POSITION_FRACTION=0.20
LIVE_CAPITAL_LIMIT_USD=10
PAPER_BALANCE_USD=100
ENTRY_WINDOW_SECONDS=180
MINIMUM_SECONDS_TO_CLOSE=20
POLL_INTERVAL_SECONDS=5
# Evaluate changed websocket books between polls through the same model, edge,
# liquidity, and risk gates. At most two positions may be open, and the runtime
# permits only one per correlation cluster (crypto, metals, energy).
EVENT_DRIVEN_ENTRY_ENABLED=true
EVENT_ENTRY_MIN_INTERVAL_SECONDS=2.0
PREDICTOR_MAX_CONCURRENT=2
PREDICTOR_MAX_CANDIDATES_PER_CYCLE=2
MIN_MODEL_PROBABILITY=0.72
MIN_EXECUTABLE_EDGE=0.05
# Ceiling on the executable edge. An edge larger than this against a live book
# has empirically been a bad book read, not an opportunity: of the first 14 live
# trades, all four above 0.193 lost and all ten below 0.139 won. Set 0 to
# disable. Calibrated on a small sample — revisit as trades accumulate.
MAX_EXECUTABLE_EDGE=0.12
# How far the pre-order book re-read may improve on the discovery snapshot
# before it is treated as a fault rather than a windfall. Set 0 to disable.
MAX_QUOTE_IMPROVEMENT=0.10

# --- Late-market entry -------------------------------------------------------
# Inside the final LATE_ENTRY_SECONDS the terminal distribution is much tighter,
# so a smaller edge is genuinely worth taking. Kalshi's taker fee also shrinks
# toward the price extremes (0.07*C*P*(1-P) peaks at 50c), so a 2% edge on a 90c
# contract clears fees several times over. Set LATE_ENTRY_SECONDS=0 to disable.
LATE_ENTRY_SECONDS=60
# The late window TIGHTENS probability while loosening edge — it is a trade, not
# a relaxation.
LATE_MIN_PROBABILITY=0.85
LATE_MIN_EDGE=0.02
# The guard that makes the above survivable: the strike must be this many
# standard deviations away. Near expiry a 97% probability can mean "far clear"
# or "a hair above with seconds left"; only the second can be flipped by Kraken
# and CF Benchmarks disagreeing. Set 0 to disable (not recommended).
LATE_MIN_SETTLEMENT_SIGMA=1.50
# Prefer candidates where raw probability, executable venue price, strike
# distance, regime, and directional indicators independently agree.
CONSENSUS_TAIL_PREFERRED=true
CONSENSUS_TAIL_MIN_RAW_PROBABILITY=0.97
CONSENSUS_TAIL_MIN_MARKET_PRICE=0.85
CONSENSUS_TAIL_MIN_EDGE=0.02
CONSENSUS_TAIL_MIN_SETTLEMENT_SIGMA=2.0
CONSENSUS_TAIL_REQUIRE_INDICATOR_ALIGNMENT=true
MAX_SLIPPAGE_DOLLARS=0.01
KALSHI_FEE_RESERVE_PER_CONTRACT=0.02
# Where mutable state goes when the paths below are relative. The installed
# `kx15` launcher sets this to your config directory, because `kx15 update`
# replaces the install directory and deletes the old one — a ledger written
# there is a trading history destroyed by the next upgrade. Unset in a source
# checkout, where state sits beside the code.
KX15_STATE_DIR=
TRADE_LEDGER_PATH=trade_ledger.db
# Secondary append-only audit stream. The SQLite ledger above is canonical.
TRADE_LOG_PATH=trades.jsonl
STATUS_CHECK_LEAD_SECONDS=5
SETTLEMENT_POLL_SECONDS=2

# Deprecated sizing input, accepted for compatibility and ignored by execution.
KELLY_FRACTION=0.25
MIN_CONTRACTS=1

# Safety gates. A model that disagrees with a liquid market by more than
# MAX_MODEL_MARKET_DIVERGENCE is treated as a data fault, not an edge.
MAX_MODEL_MARKET_DIVERGENCE=0.125
MAX_CANDLE_AGE_SECONDS=120
ORDER_FAILURE_COOLDOWN_SECONDS=60

# Circuit breakers. Trading halts when either is reached.
MAX_CONSECUTIVE_LOSSES=3
MAX_DRAWDOWN_FRACTION=0.60
# Optional absolute UTC-day loss rail; 0 disables it. Halt state is durable.
MAX_DAILY_LOSS_USD=0

# Concurrent outbound requests per venue.
REQUEST_CONCURRENCY=4
# Smooth all Kalshi request starts across the 12-asset burst. Set 0 only when a
# separate gateway provides a stricter rate limiter.
KALSHI_REQUEST_MIN_INTERVAL_SECONDS=0.35

# Regime-aware model. When true the predictor classifies the one-minute chart
# (TREND / CONSOLIDATION / REVERSAL / VOLATILE_CHOP) and scales drift, drift
# persistence, volatility, and shrinkage accordingly. Set false to fall back to
# the plain momentum model for an A/B comparison.
REGIME_AWARE_MODEL=true

# Append-only record of every evaluation and the reasoning behind it, including
# the ones that did not trade. Read it with: python view_decisions.py
DECISION_LOG_ENABLED=true
DECISION_LOG_PATH=decisions.jsonl

# --- Unsupervised regime model (optional, default OFF) -----------------------
# Path to a fitted Gaussian mixture artifact from research/fit_regime_model.py.
# Leave empty to use the hand-tuned classifier. Setting this replaces the regime
# multipliers with a posterior-weighted blend; startup fails loudly if the file
# is missing, so a typo cannot silently fall back.
REGIME_MODEL_PATH=

# --- Runtime paper/live switch -----------------------------------------------
# The monitoring dashboard can move the bot between paper and live without a
# restart. It writes a request to this file; the bot reads it between trades and
# re-checks every live prerequisite itself, so the file cannot grant a
# permission this .env withheld. Defaults beside the ledger.
MODE_CONTROL_PATH=runtime_mode.json
# Set false to ignore the file entirely: the mode the process starts with is the
# mode it keeps for its whole life. The right setting for an unattended box
# where nobody should be able to change what it trades without an ssh session.
MODE_CONTROL_ENABLED=true
# How long the decision log is kept before it is DISCARDED. It is a rolling
# diagnostic window, not an archive: at ~106 MB per day of continuous running it
# reaches 38 GB in a year, and every reader has to scan the whole file. Nothing
# downstream treats it as durable — the ledger holds the trades and model
# training reads market history rebuilt from the exchange. Set 0 to keep
# everything, which is what the old behaviour was.
DECISION_LOG_RETENTION_HOURS=24

# --- Logs and reports --------------------------------------------------------
# Where the human-readable run log and the PDF performance reports land.
# Deliberately not the state directory: the ledger is the machine's record and
# belongs beside the config, while these two are for a person to read, so they
# go where a person will find them. Defaults to ~/kx15_Performance_Logs, or
# ~/Desktop/kx15_Performance_Reports on Windows.
KX15_LOG_DIR=
# The run log rotates weekly at Sunday 00:00, or at this size, whichever comes
# first. Rotation discards the previous log; it never touches the ledger or
# trades.jsonl, which are the durable record.
KX15_LOG_MAX_BYTES=536870912
# quiet   trades, settlements, halts, mode switches and errors
# verbose adds the per-evaluation commentary
# silent  warnings and above only
KX15_LOG_CONSOLE=quiet
# Write a PDF performance report at the end of a paper session. `kx15 report`
# works whatever this is set to; this only governs the unattended one.
KX15_REPORTS_ENABLED=true

# --- Storefront (seller-side only; the bot ignores all of these, and the
#     release strips everything from this marker down) -----------------------
# Mode. Anything else runs in staging: no HSTS, cookies not marked Secure, and
# a missing secret is a warning rather than a refusal to start.
STOREFRONT_ENV=staging
# Mailtrap. Sandbox is the default and captures mail in an inbox instead of
# sending it; switch it off only when you mean to mail real customers.
MAILTRAP_API_TOKEN=
MAILTRAP_SANDBOX=true
MAILTRAP_INBOX_ID=
MAIL_FROM=
MAIL_FROM_NAME=KX15
MAIL_REPLY_TO=
# Who the customer is contracting with, and whose law governs. The terms page
# shows a visible warning while these are unset.
SELLER_NAME=
SELLER_CONTACT=
SELLER_JURISDICTION=
# Developer access. With this unset there is no bypass at all. Set it on the
# server and locally, then mint a short-lived token:
#   python -m storefront.developer --hours 2
#   ./scripts/e2e.sh --remote https://yourdomain
# Optionally narrow it further to addresses or CIDR blocks; the signature is
# what authenticates, so this is belt and braces.
# --- Fingerprint Pro (optional device intelligence at checkout) --------------
# With no public key the agent never loads, nothing is fetched, and the
# Content-Security-Policy stays exactly as strict as it is without it.
# The public key is embedded in the page by design; the secret key must never
# leave the server. The storefront refuses to start if they are set equal.
FINGERPRINT_PUBLIC_API_KEY=
FINGERPRINT_SECRET_API_KEY=
# us | eu | ap — must match the region the workspace was created in. A key from
# an EU workspace queried against the US endpoint returns 403.
FINGERPRINT_REGION=us
FINGERPRINT_TIMEOUT_SECONDS=4

DEV_LICENSE_SECRET=
DEV_LICENSE_IPS=
# A developer licence key that looks exactly like a customer's, so it exercises
# the paths a `kx15dev.` token skips. The plaintext lives here; only its HMAC is
# committed, in storefront/dev_pins.json, along with the HMAC of the address
# allowed to fetch it from /api/dev/license. Create the pair with:
#     python -m storefront.developer --new-key
#     python -m storefront.developer --pin-address <your public IP>
DEV_LICENSE_KEY=
# Keys the HMAC that licence hashes and network hashes are derived from. At
# least 32 characters, and never rotated after the first sale: rotating it
# invalidates every licence ever issued.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
LICENSE_SECRET=
# Guards /api/deliveries and /api/fraud, which expose other customers' data.
# Unset, those endpoints answer 404 to anything that is not loopback.
OPERATOR_TOKEN=

# --- Maker fill modelling (paper only) ---------------------------------------
# The paper fill model credits a fill only when the book trades THROUGH the
# resting price, never merely at it. That is deliberately pessimistic and makes
# paper P&L a lower bound rather than an estimate.
#
# A real maker order also fills the ordinary way: it sits at the touch and the
# queue in front of it is consumed. Kalshi publishes that queue directly for
# resting orders (contracts that must match ahead of you, on price-time
# priority) and the bot reads it in live mode. On paper there is no resting
# order to ask about, so the queue is inferred from the size still resting at
# our price - which also falls when someone ahead CANCELS, and therefore decays
# faster than a real queue.
#
# Leaving this false keeps the pessimistic rule. Either way every quote writes
# a `scalp_queue_position` record, so the paper estimate can be compared
# against Kalshi's real answer on live quotes before it is trusted.
SCALP_QUEUE_AWARE_FILLS=false

# --- Kraken candle stream ----------------------------------------------------
# Stream the in-progress one-minute candle over a websocket instead of
# re-polling every asset every pass. Spot is fresher (sub-second rather than up
# to POLL_INTERVAL_SECONDS stale) and the request rate stops scaling with the
# number of assets traded.
#
# REST polling stays underneath as the fallback and is used on any read the
# stream cannot serve. That matters more than it sounds: a poll that fails is
# loud, while a stream that dies quietly keeps a well-formed candle in memory
# that simply stops advancing - so every read checks how long it has been since
# the socket last delivered a candle, and falls back past the threshold below.
KRAKEN_STREAM_ENABLED=true
# How long a silent stream may still be believed. Kraken sends a row per asset
# per minute, so 90s is roughly one missed minute plus slack.
KRAKEN_STREAM_STALE_SECONDS=90

# Deprecated confidence-sizing inputs. They remain parseable so an older .env
# still boots, but fixed-budget execution intentionally ignores all four.
SIZING_CONFIDENCE_GAIN=1.0
SIZING_CONFIDENCE_FLOOR=0.60
SIZING_CONFIDENCE_FULL=0.90
SIZING_MAX_FRACTION=0.20

# --- Exposure-scaled oversight (default OFF) ---------------------------------
# How closely a position is watched, from the share of the portfolio it risks.
# It changes WHEN and HOW OFTEN the salvage rule is asked - never the price at
# which it acts, which stays SALVAGE_MAX_BID, the only region where the
# favourite-longshot overpricing was actually measured.
OVERSIGHT_ENABLED=false
# Exposure at which a position earns every check available. Beyond it nothing
# further is granted, so an outsized position cannot demand unbounded attention.
OVERSIGHT_FULL_EXPOSURE=0.25
# The window at full exposure. The base is SALVAGE_WINDOW_SECONDS and this must
# be at least that; a 30% position examined once with 30 seconds left has not
# been supervised.
OVERSIGHT_MAX_WINDOW_SECONDS=300
# Checks at full exposure. Capped at 20 because a rule re-asked every poll
# eventually says yes to noise - that is how the exit-on-reversal failed.
OVERSIGHT_MAX_CHECKS=4
# Minimum gap between two evaluations of the same position. This is what keeps
# the extra checks supervision rather than a poll loop.
OVERSIGHT_MIN_SPACING_SECONDS=20
# RECORDED, NEVER OBEYED. Every check logs what this wider band would have sold
# and the position's settled outcome follows it into the ledger, so "should a
# large position be cut earlier?" becomes a question the data answers rather
# than one this file guesses at. Must be at least SALVAGE_MAX_BID.
OVERSIGHT_SHADOW_MAX_BID=0.35
# Time to cut. Under this many seconds to close, no check is scheduled at all:
# an atomic exit must still reach the venue before close. Must stay below
# SALVAGE_WINDOW_SECONDS, or the base window closes before it opens.
# 0 is the historical behaviour exactly.
SALVAGE_MIN_ACTIONABLE_SECONDS=0
# Added to the floor above at full exposure. A larger position consumes more of
# the book and needs more transport runway.
OVERSIGHT_EXTRA_ACTIONABLE_SECONDS=0

# --- Size-scaled probability floor (inert at the default) --------------------
# Added to MIN_MODEL_PROBABILITY in proportion to actual post-depth exposure.
# It is an admission rule only; probability never changes the fixed dollar
# budget. Checked after sizing because depth can reduce actual exposure.
SIZE_PROBABILITY_UPLIFT=0
# Exposure at which the full uplift applies.
SIZE_PROBABILITY_FULL_EXPOSURE=0.25

# --- Scalping mode (maker-side quoting) --------------------------------------
# Quotes post_only inside the spread on the favourite band instead of crossing
# it. Enabling this grants no live permission: live still needs both
# ENABLE_LIVE_TRADING=true and the --live flag.
#
# READ THIS BEFORE SETTING IT: bot.py ignores SCALP_ENABLED. Its --strategy
# flag defaults to "all" and overwrites this field at startup, so scalping is
# ON unless you pass `--strategy predictor`. The variable is still read by
# KalshiSettings.from_env for other entry points; under bot.py it is inert.
SCALP_ENABLED=false
# The favourite band. The floor is the win-rate guarantee expressed as a price:
# break-even needs price+fee. Local settled trades and the reference study both
# favor 70c+ contracts over the 60-69c band.
SCALP_PRICE_BAND_LOW=0.70
SCALP_PRICE_BAND_HIGH=0.92
SCALP_MIN_EV_PER_DOLLAR=0.015
SCALP_MAX_SPREAD=0.02
# At least ~1.4x the contracts a $50 entry can need in the 70-92c band.
# Full opposing depth and modeled liquidation loss are checked again after sizing.
SCALP_MIN_BOOK_DEPTH=100
SCALP_QUOTE_TTL_SECONDS=20
SCALP_REQUOTE_TICKS=2
# One slot per traded asset, so every market that clears the band can carry a
# quote. Defaults to the number of series in SERIES_BY_ASSET.
SCALP_MAX_CONCURRENT=12
# A ceiling, not an allocation: capital is a shared pool and scalping competes
# for it on expected value. This only stops one strategy starving the other.
SCALP_MAX_CAPITAL_FRACTION=0.50
SCALP_TAKER_FALLBACK=true
SCALP_MIN_SECONDS_TO_CLOSE=120

# --- Ladder arbitrage (daily strike ladder, off by default) ------------------
# The 15-minute series has ONE strike per event, so there is no ladder there to
# be inconsistent. This scans the daily series instead, where 36 markets share
# an underlying and must satisfy monotonicity and convexity.
LADDER_ARB_ENABLED=false
LADDER_ARB_SERIES=KXBTCD
LADDER_ARB_BUFFER=0.02
LADDER_ARB_MAX_CONTRACTS=25
# How far above the EV floor a setup must sit before crossing the spread is
# worth it. Maker-heavy by construction: 1.0 would cross on every expired quote
# and turn this into the taker strategy it exists to improve on.
SCALP_TAKER_EDGE_MULTIPLE=2.0

# --- Pattern gates: only quote structure the classifier can name -------------
# VOLATILE_CHOP is by definition the regime where price shape carries no
# information, so quoting it is quoting noise.
SCALP_BLOCKED_REGIMES=VOLATILE_CHOP
SCALP_MIN_REGIME_CONFIDENCE=0.0
# Minimum |z| between spot and the strike, in terminal standard deviations. A
# contract near the middle is decided by whichever way the settlement index
# rounds, not by the model.
SCALP_MIN_ABS_Z=0.50
# Seconds before a bounded session ends inside which no NEW position is opened,
# because nothing will be left watching it settle.
SCALP_SESSION_TAIL_SECONDS=900

# --- Order-book microstructure ----------------------------------------------
# Grounded in Bartlett & O'Hara (2026) "Adverse Selection in Prediction Markets:
# Evidence from Kalshi" (41.6M trades) and Becker, "Prediction Market
# Microstructure".
SCALP_ORDERBOOK_ENABLED=true
# "taker" crosses the spread now; "maker" rests a post_only quote first. Taker
# is the default: five paper sessions produced ZERO maker fills, and Becker puts
# the maker-taker gap in the Finance category (where 15m crypto sits) at 0.17pp.
SCALP_ORDER_STYLE=taker
# One-sided resting liquidity as a static VPIN proxy. Bartlett & O'Hara find
# one-sided flow predicts maker losses in single-name markets.
SCALP_MAX_TOXICITY=0.85
# Full-position round-trip stress: refuse an entry when the current opposing
# touch lacks depth or flattening immediately would lose more than this amount.
SCALP_MAX_MODELED_EXIT_LOSS_USD=1.18
# Reward for trading against resting crowd pressure, penalty for joining it.
# Traders buy YES 61% of the time; YES settles 32% of the time.
SCALP_CROWD_WEIGHT=0.0
# --- Executable profit capture and bounded side switching -------------------
# Poll open positions using the same public book in paper/live. Sell only when
# the whole position clears this NET gain after the estimated exit fee.
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_PER_CONTRACT=0.05
# Require 75% of the maximum per-contract settlement profit before a routine
# take-profit can clip a winner. Deterioration/salvage exits remain separate.
TAKE_PROFIT_MIN_CAPTURE_FRACTION=0.75
# Hold while model confidence remains at least two points above the exit bid.
TAKE_PROFIT_CONFIDENCE_MARGIN=0.02
# Explicit full-window winner veto. Routine take-profit is blocked when either
# the book reaches the strong threshold OR book and held-side model agree.
TAKE_PROFIT_WINNING_HOLD_ENABLED=true
TAKE_PROFIT_WINNING_HOLD_MIN_BID=0.85
TAKE_PROFIT_WINNING_HOLD_MIN_PROBABILITY=0.65
TAKE_PROFIT_WINNING_HOLD_STRONG_BOOK_BID=0.95
# Zero applies the winner veto throughout the position's lifetime. A positive
# value restores an optional final-N-seconds scope.
TAKE_PROFIT_WINNING_HOLD_MAX_SECONDS_TO_CLOSE=0
TAKE_PROFIT_WINNING_HOLD_CONFIRMATIONS=2
# Advisory only by default. Even when enabled for diagnostics, reversal signals
# cannot bypass the all-in break-even floor or the ordinary profit target.
CONFIRMED_REVERSAL_ENABLED=false
# These thresholds are retained for shadow diagnostics and the paper strategy
# lab. They do not authorize a loss-making production exit.
CONFIRMED_REVERSAL_CONFIRMATIONS=2
CONFIRMED_REVERSAL_MIN_SIGNALS=3
CONFIRMED_REVERSAL_PROBABILITY_MAX=0.48
CONFIRMED_REVERSAL_PEAK_DRAWDOWN=0.15
TAKE_PROFIT_MAX_SPREAD=0.03
TAKE_PROFIT_MIN_SECONDS_TO_CLOSE=30
# Reassess every 15s while the position is young, then every 5s in the final
# two minutes. Each verdict is recorded, including holds and failed gates.
TAKE_PROFIT_CHECK_INTERVAL_SECONDS=15
TAKE_PROFIT_FAST_WINDOW_SECONDS=120
TAKE_PROFIT_FAST_CHECK_SECONDS=5

# Paper-only parallel strategy laboratory. Each policy starts with an
# independent wallet and receives the same Kalshi/Kraken observations.
STRATEGY_LAB_ENABLED=true
STRATEGY_LAB_PATH=strategy_lab.db
STRATEGY_LAB_BALANCE_USD=100
# After this many consecutive settled/realised losses, stop opening scalper
# quotes and admit only fixed-size predictor trades that pass all three floors.
# This is higher selectivity, not a guarantee and never a martingale.
SAFE_MODE_ENABLED=true
SAFE_MODE_LOSS_TRIGGER=3
SAFE_MODE_MIN_PROBABILITY=0.92
SAFE_MODE_MIN_MARKET_PRICE=0.85
SAFE_MODE_MIN_SETTLEMENT_SIGMA=2.0
SAFE_MODE_CONSENSUS_ONLY=true
# Authenticated sequenced Kalshi book stream. REST polling remains the fallback.
KALSHI_WEBSOCKET_ENABLED=true
KALSHI_WEBSOCKET_STALE_SECONDS=10
EVENT_REASSESSMENT_MIN_INTERVAL_SECONDS=0.5
# Initial entry plus one opposite-side entry after a profitable take-profit.
# Same-side churn and re-entry after a loss/salvage are always refused.
MAX_ENTRIES_PER_MARKET=2

# --- Strict simulation/training data -----------------------------------------
MARKET_DATA_ENABLED=true
# Discovery top-of-book is stored for every trading asset. Exact normalized
# depth levels require an extra read and default to BTC for this project.
ORDERBOOK_RECORDING_ASSETS=ALL
ORDERBOOK_REST_RECONCILE_SECONDS=30
# The websocket always reconstructs every configured book in memory. Raw
# per-delta persistence is intentionally off: active markets can emit 1,000+
# rows/second and must never delay orders. Full-depth periodic snapshots still
# cover every asset. Enable only in a dedicated collector process/state DB.
RAW_BOOK_EVENT_RECORDING_ENABLED=false
# Public market prints are lower-volume and are persisted in one-second
# batches, so they remain useful for training without one fsync per trade.
PUBLIC_TRADE_RECORDING_ENABLED=true

# --- Isolated Kalshi complementary-pair arbitrage shadow --------------------
# Enabled only by `--strategy arb`; there is intentionally no live execution
# path. Kalshi has one net YES book rather than two mergeable outcome tokens,
# so a buyable YES+NO pair below $1 means the book is crossed and is normally
# matched away before a REST poll can act. Every scan is still stored so the
# frequency, depth and apparent edge can be measured honestly.
PAIR_ARB_MIN_NET_EDGE=0.02
PAIR_ARB_MIN_LEG_PRICE=0.02

# --- Salvage exit (deep-longshot loss reduction, default OFF) ----------------
# One evaluation per position, SALVAGE_WINDOW_SECONDS before its market closes:
# sell the whole thing back into the book, or carry it to settlement. It is
# PRICE-triggered and never consults the model. That is the entire difference
# between it and the exit-on-reversal that was removed after it sold a live BTC
# position at 0.61 for -$1.73 on a market that then settled in that position's
# favour. It can only ever sell the outcome already held (reduce_only), never
# switch sides, and never open a position.
SALVAGE_ENABLED=false
# How long before close the single evaluation happens.
SALVAGE_WINDOW_SECONDS=30
# The longshot ceiling, and the rule's real constraint. Burgi, Deng & Whelan
# (2026) measure contracts at or below 10c returning worse than -60% over
# 313,972 contracts, so the book overpays for them and selling into it collects
# a documented bias rather than betting against the market. Above ~0.20 no such
# overpricing is measured, so config refuses a higher value.
SALVAGE_MAX_BID=0.15
# The exit is paid out of the spread. Measured sensitivity puts the edge at zero
# by 3-4c even deep in the band, so config refuses above 0.03.
SALVAGE_MAX_SPREAD=0.02
# How far a longshot's price overstates its worth. Deliberately weaker than the
# >=60% measured; the paper's sample is 24h-10d markets, not 15-minute crypto.
# Zero makes the rule inert, which is the safe degenerate.
SALVAGE_LONGSHOT_HAIRCUT=0.40
# Per contract, so a marginal case does not churn a position for a rounding.
# Being absolute, it also imposes a price floor: at a 4c bid a 2c spread is half
# the contract's value and nothing clears this.
SALVAGE_MIN_GAIN_PER_CONTRACT=0.01

# Seconds between console scan lines. Events (trade, settlement, halt) are never
# throttled and the log file keeps every line at DEBUG.
SCAN_LOG_INTERVAL_SECONDS=10
