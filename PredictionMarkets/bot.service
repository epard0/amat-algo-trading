[Unit]
Description=Kalshi 15m Crypto Bot Service (live, continuous)
Documentation=file:///home/kalshibot/Polymarket-BTC-15-Minute-Trading-Bot/CLAUDE.md
After=network-online.target
Wants=network-online.target
# A bad .env or a missing/ill-permissioned key exits 1 immediately; back off
# instead of spinning on it.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kalshibot
Group=kalshibot
WorkingDirectory=/home/kalshibot/Polymarket-BTC-15-Minute-Trading-Bot

# bot.py calls load_dotenv(PROJECT_ROOT/".env") itself; ENABLE_LIVE_TRADING=true
# must be set there or --live is rejected at startup.
Environment=PYTHONUNBUFFERED=1
# ProtectSystem=strict below mounts the whole hierarchy read-only except the
# paths in ReadWritePaths=, and $HOME is inside "the whole hierarchy". The
# default log directory is ~/kx15_Performance_Logs, so without this the first
# ensure_log_dir() mkdir raises PermissionError and the unit crash-loops into
# StartLimitBurst. Point it inside WorkingDirectory, which is already writable
# and which the bot creates itself - no pre-existing directory required.
Environment=KX15_LOG_DIR=/home/kalshibot/Polymarket-BTC-15-Minute-Trading-Bot/kx15_Performance_Logs
ExecStart=/home/kalshibot/Polymarket-BTC-15-Minute-Trading-Bot/.venv/bin/python \
    /home/kalshibot/Polymarket-BTC-15-Minute-Trading-Bot/bot.py \
    --live --continuous --silent

# SIGTERM sets the stop flag and the loop unwinds; give it room to finish a
# settlement poll and close the ledger cleanly before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=60

Restart=always
RestartSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kalshibot

# Hardening. ProtectHome is deliberately omitted: the ledger (trade_ledger.db),
# decisions.jsonl, trades.jsonl and the .pem key all live under the home dir.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/home/kalshibot/Polymarket-BTC-15-Minute-Trading-Bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
