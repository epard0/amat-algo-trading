        "id": "simulation_analysis",
        "label": "Isolated simulation ledgers and derived analysis",
        "path": "reports/20260824_simulation_analysis/analysis_summary.json",
        "query": {
          "engine": "sqlite",
          "language": "sql",
          "sql": "ATTACH DATABASE 'data/simulations/20260824_all_assets_2h/trade_ledger.db' AS ledger_0;\nATTACH DATABASE 'data/simulations/20260824_all_assets_2h/strategy_lab.db' AS lab_0;\nATTACH DATABASE 'data/simulations/20260824_all_assets_new_models_to_6pm_v2/trade_ledger.db' AS ledger_1;\nATTACH DATABASE 'data/simulations/20260824_all_assets_new_models_to_6pm_v2/strategy_lab.db' AS lab_1;\nATTACH DATABASE 'data/simulations/20260824_final_2h_new_models_adaptive_exit/trade_ledger.db' AS ledger_2;\nATTACH DATABASE 'data/simulations/20260824_final_2h_new_models_adaptive_exit/strategy_lab.db' AS lab_2;\nSELECT 'legacy_2h' AS run_label, 'main_trade' AS record_type, json_object('trade_id', trade_id, 'ticker', ticker, 'asset', asset, 'outcome', outcome, 'status', status, 'pnl', pnl) AS record_json FROM ledger_0.trades\nUNION ALL\nSELECT 'legacy_2h', 'lab_position', json_object('position_id', position_id, 'strategy', strategy, 'ticker', ticker, 'outcome', outcome, 'status', status, 'pnl', pnl) FROM lab_0.lab_positions\nUNION ALL\nSELECT 'legacy_2h', 'market_count', json_object('snapshots', COUNT(*), 'contracts', COUNT(DISTINCT ticker)) FROM ledger_0.market_snapshots\nUNION ALL\nSELECT 'checkpoint' AS run_label, 'main_trade' AS record_type, json_object('trade_id', trade_id, 'ticker', ticker, 'asset', asset, 'outcome', outcome, 'status', status, 'pnl', pnl) AS record_json FROM ledger_1.trades\nUNION ALL\nSELECT 'checkpoint', 'lab_position', json_object('position_id', position_id, 'strategy', strategy, 'ticker', ticker, 'outcome', outcome, 'status', status, 'pnl', pnl) FROM lab_1.lab_positions\nUNION ALL\nSELECT 'checkpoint', 'market_count', json_object('snapshots', COUNT(*), 'contracts', COUNT(DISTINCT ticker)) FROM ledger_1.market_snapshots\nUNION ALL\nSELECT 'final' AS run_label, 'main_trade' AS record_type, json_object('trade_id', trade_id, 'ticker', ticker, 'asset', asset, 'outcome', outcome, 'status', status, 'pnl', pnl) AS record_json FROM ledger_2.trades\nUNION ALL\nSELECT 'final', 'lab_position', json_object('position_id', position_id, 'strategy', strategy, 'ticker', ticker, 'outcome', outcome, 'status', status, 'pnl', pnl) FROM lab_2.lab_positions\nUNION ALL\nSELECT 'final', 'market_count', json_object('snapshots', COUNT(*), 'contracts', COUNT(DISTINCT ticker)) FROM ledger_2.market_snapshots;",
          "description": "Extracts the raw main trades, strategy-lab positions, and market counts used by the reproducible Python analysis.",
          "executed_at": "2026-08-24T19:59:34.679381-04:00",
          "tables_used": [
            "ledger_0.data_runs",
            "ledger_0.market_snapshots",
            "ledger_0.trades",
            "ledger_0.position_evaluations",
            "ledger_0.pair_arb_observations",
