# ---------------------------------------------------------------------------
# Evidence directories.
#
# data/ holds immutable, checksum-addressed vendor snapshots and normalized
# tables. outputs/ holds run artifacts, validated results, and reports.
# Neither is version controlled: provenance is carried by manifests, not git.
# See docs/data-dictionary.md for the required layout and manifest schema.
# ---------------------------------------------------------------------------
/data/
/outputs/

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp

# Local secrets and overrides (never commit)
.env
.env.*
secrets/
credentials/

# Claude Code worktrees
worktrees/
