# Copy to .env, chmod 600, and fill only the providers you use.
# Load with uv --env-file, or the root ./research wrapper.
ALPACA_MARKET_API_KEY=
ALPACA_MARKET_API_SECRET=
# Optional model providers. Configure model IDs in a private model-chain TOML.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
# Optional override: absolute path to your reviewed provider/model policy.
# AMAT_MODEL_CHAIN=/absolute/path/model-chain.toml
# Optional usage ledger override. Default is outside the source checkout.
# AMAT_COST_LEDGER=/absolute/path/costs.sqlite3
